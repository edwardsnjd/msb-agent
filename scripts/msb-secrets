#! /usr/bin/env bash

# Expose proxied secrets to the first sandbox for this PWD

firstId="$(msb ps --label "msb.pwd=$PWD" --quiet | head -1)"

if [[ -n "$firstId" ]]; then
  exec msb modify
    --secret "PERPLEXITY_API_KEY@api.perplexity.ai" \
    --secret "OPENROUTER_API_KEY@openrouter.ai" \
    --secret "INCEPTION_API_KEY@api.inceptionlabs.ai" \
    --mount-dir "$(realpath $HOME/.agents):/root/.agents:ro" \
    "$@" \
    "$firstId"
else
  echo "No sandbox found for this PWD" >&2
fi
